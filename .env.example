# Langfuse v3 — Environment Variables Reference
# ================================================
# All secrets use ${{ secret(N) }} in the template — never hardcode.
# These are generated automatically by Railway on first deploy.

# --- Shared (root-level) variables ---
ENCRYPTION_KEY=         # Auto: ${{ secret(32) }} — 64-char hex key for encrypting data at rest
NEXTAUTH_SECRET=        # Auto: ${{ secret(32) }} — session/JWT signing key
SALT=                   # Auto: ${{ secret(32) }} — API key hashing salt

# --- Postgres (image: postgres:17-alpine) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=      # Auto: ${{ secret(32) }} — master DB password
POSTGRES_DB=postgres
POSTGRES_PORT=5432
# Volume: /var/lib/postgresql/data

# --- Redis (image: redis:7-alpine) ---
REDIS_AUTH=             # Auto: ${{ secret(32) }} — Redis password (used by BullMQ)
REDIS_PORT=6379
# Volume: /data

# --- ClickHouse (image: clickhouse/clickhouse-server:25.12) ---
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=    # Auto: ${{ secret(32) }} — ClickHouse password
CLICKHOUSE_DB=default
CLICKHOUSE_PORT=9000
CLICKHOUSE_HTTP_PORT=8123
# Volumes: /var/lib/clickhouse, /var/log/clickhouse-server

# --- MinIO (image: minio/minio:RELEASE.2025-09-07T16-13-09Z) ---
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=    # Auto: ${{ secret(32) }} — MinIO admin password
MINIO_BUCKET=langfuse
MINIO_DATA_DIR=/data
# Volume: /data
# Bucket directory pre-created by docker-entrypoint.sh

# --- Langfuse Web (image: docker.langfuse.com/langfuse/langfuse:4) ---
NEXTAUTH_URL=           # Auto: https://${{ RAILWAY_PUBLIC_DOMAIN }}
DATABASE_URL=           # Auto: postgresql connection to postgres service
CLICKHOUSE_URL=         # Auto: http connection to clickhouse service
LANGFUSE_S3_EVENT_UPLOAD_ENDPOINT=    # Auto: http to minio service
LANGFUSE_S3_MEDIA_UPLOAD_ENDPOINT=    # Auto: http to minio service
