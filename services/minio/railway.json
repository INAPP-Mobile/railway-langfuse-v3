{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "dockerfile",
    "dockerfilePath": "services/minio/Dockerfile"
  },
  "deploy": {
    "healthcheckPath": "/minio/health/live",
    "healthcheckTimeout": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "volumeMounts": [
      {
        "name": "minio-data",
        "mountPath": "/data"
      }
    ]
  }
}
